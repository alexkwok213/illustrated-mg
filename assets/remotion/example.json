  "captions": [
    {
      "start": 0.0,
      "text": "为什么菜单上多了一杯咖啡",
      "end": 2.82
    },
    {
      "start": 2.82,
      "text": "你反而换了主意？",
      "end": 4.46
    },
    {
      "start": 4.46,
      "text": "假设小杯十二块",
      "end": 6.11
    },
    {
      "start": 6.11,
      "text": "中杯十六块",
      "end": 7.28
    },
    {
      "start": 7.28,
      "text": "只看这两杯",
      "end": 8.46
    },
    {
      "start": 8.46,
      "text": "你可能觉得",
      "end": 9.63
    },
    {
      "start": 9.63,
      "text": "多花四块",
      "end": 10.57
    },
    {
      "start": 10.57,
      "text": "值吗？",
      "end": 11.04
    },
    {
      "start": 11.04,
      "text": "现在旁边摆上一杯二十二块的大杯",
      "end": 14.57
    },
    {
      "start": 14.57,
      "text": "中杯一滴没多",
      "end": 15.98
    },
    {
      "start": 15.98,
      "text": "却多了个理由",
      "end": 17.39
    },
    {
      "start": 17.39,
      "text": "比小杯喝得尽兴",
      "end": 19.04
    },
    {
      "start": 19.04,
      "text": "又不用花到二十二",
      "end": 20.91
    },
    {
      "start": 20.91,
      "text": "当一个选项在价格和分量上都处在两头之间",
      "end": 25.38
    },
    {
      "start": 25.38,
      "text": "它就更容易成为说得过去的选择",
      "end": 28.67
    },
    {
      "start": 28.67,
      "text": "这叫折中效应",
      "end": 30.08
    },
    {
      "start": 30.08,
      "text": "所以设计三档套餐时",
      "end": 32.2
    },
    {
      "start": 32.2,
      "text": "问一句",
      "end": 32.9
    },
    {
      "start": 32.9,
      "text": "顾客每多花这笔钱",
      "end": 34.78
    },
    {
      "start": 34.78,
      "text": "究竟能多得到什么？",
      "end": 36.66
    },
    {
      "start": 36.66,
      "text": "把差别写清楚",
      "end": 38.07
    },
    {
      "start": 38.07,
      "text": "顾客才好选",
      "end": 39.64
    }
  ]
}
